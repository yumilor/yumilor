  <diagram name="Page-1" id="Qyq_XCGGUoy-ZOqNg198">
    <mxGraphModel dx="1012" dy="606" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="&lt;div style=&quot;font-size: 1px&quot;&gt;&lt;p style=&quot;text-align:justify;margin-left:51;margin-right:0;margin-top:0px;margin-bottom:0px;text-indent:-25.4;vertical-align:middle;direction:ltr;&quot;&gt;&lt;font style=&quot;font-size:16.93px;font-family:Calibri;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;1.&#x9;PURPOSE&lt;/font&gt;&lt;font style=&quot;font-size:15.52px;font-family:Calibri;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;&lt;br/&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;text-align:justify;margin-left:76;margin-right:0;margin-top:8px;margin-bottom:0px;text-indent:-25.4;vertical-align:middle;direction:ltr;&quot;&gt;&lt;ul style=&quot;margin: 0;list-style-type: disc&quot;&gt;&lt;font style=&quot;font-size:14.11px;font-family:Calibri;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;&lt;li&gt;To ensure all activities, laboratory facility usage, and supporting equipment are recorded accurately, thoroughly, and digitally integrated.&lt;/li&gt;&lt;li&gt;To facilitate the monitoring of laboratory usage and resources for Laboratory Coordinator (Laboran), Lab Managers, and Human Resources (HR).&lt;/li&gt;&lt;li&gt;To maintain order, cleanliness, and occupational safety within the laboratory environment.&lt;/font&gt;&lt;font style=&quot;font-size:15.52px;font-family:Calibri;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/p&gt;&lt;p style=&quot;text-align:justify;margin-left:0;margin-right:0;margin-top:0px;margin-bottom:0px;text-indent:0;vertical-align:middle;direction:ltr;&quot;&gt;&lt;font style=&quot;font-size:16.93px;font-family:Calibri;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;2.&#x9;SCOPE&lt;br/&gt;&lt;/font&gt;&lt;font style=&quot;font-size:14.11px;font-family:Calibri;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;This SOP applies strictly to all operations, equipment, and personnel within the Mechanical Engineering Lab and Manufacturing Lab (MIML), including all users (Students, Lecturers, Staff, and Authorized External Visitors).&lt;/font&gt;&lt;font style=&quot;font-size:15.52px;font-family:Calibri;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;&#x9;&lt;br/&gt;&lt;/font&gt;&lt;font style=&quot;font-size:16.93px;font-family:Calibri;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;3.       REFERENCE&lt;br/&gt;&lt;/font&gt;&lt;font style=&quot;font-size:15.52px;font-family:Calibri;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;&#x9;-&lt;/font&gt;&lt;font style=&quot;font-size:15.52px;font-family:Calibri;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;&lt;br/&gt;&lt;/font&gt;&lt;font style=&quot;font-size:15.52px;font-family:Calibri;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;&lt;br/&gt;&lt;/font&gt;&lt;font style=&quot;font-size:16.93px;font-family:Calibri;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;&lt;br/&gt;4.       RELATED DOCUMENTS&lt;br/&gt;Digital Logbook form&lt;br/&gt;&lt;/font&gt;&lt;font style=&quot;font-size:15.52px;font-family:Calibri;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;&#x9;&lt;/font&gt;&lt;font style=&quot;font-size:15.52px;font-family:Calibri;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;&lt;br/&gt;&lt;/font&gt;&lt;font style=&quot;font-size:15.52px;font-family:Calibri;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;&#x9;&lt;/font&gt;&lt;font style=&quot;font-size:15.52px;font-family:Calibri;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;&lt;br/&gt;&lt;/font&gt;&lt;font style=&quot;font-size:16.93px;font-family:Calibri;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;&lt;br/&gt;5. &#x9;DEFINITION&lt;br/&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;text-align:justify;margin-left:25;margin-right:0;margin-top:0px;margin-bottom:0px;text-indent:-25.4;vertical-align:middle;direction:ltr;&quot;&gt;&lt;ul style=&quot;margin: 0;list-style-type: disc&quot;&gt;&lt;font style=&quot;font-size:11.29px;font-family:Calibri;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;&lt;li&gt;Digital Logbook: A cloud-based record system implemented via Microsoft Forms to capture real-time usage data, user identity, machine condition, and resource utilization.&lt;/li&gt;&lt;li&gt;Laboratory User: Any authorized individual (Student, Lecturer, Staff, or External Visitor) who enters the laboratory to operate machinery or utilize tools for academic, research, or service purposes.&lt;/li&gt;&lt;li&gt;Lab coordinator/Laboran: The designated technical staff member responsible for overseeing daily laboratory operations, maintaining machinery, enforcing safety protocols, and verifying logbook data.&lt;/li&gt;&lt;li&gt;Consumables: Materials that are consumed or transformed during machine operation, such as 3D printing filaments, metal/plastic stocks, coolants, welding rods, and abrasives.&lt;/li&gt;&lt;li&gt;Laboratory Manager (Lab Manager): The administrative and operational leader responsible for overall laboratory oversight, safety compliance, facility scheduling, budget management, and SOP enforcement.&lt;/li&gt;&lt;li&gt;PPE (Personal Protective Equipment): Mandatory safety gear required during lab operations (e.g., safety glasses, lab coats, steel-toe boots, ear protection).&lt;/font&gt;&lt;font style=&quot;font-size:16.93px;font-family:Calibri;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/p&gt;&lt;/div&gt;" tags="Background" id="SCmo_TpzK8uncBphzd-z-1">
